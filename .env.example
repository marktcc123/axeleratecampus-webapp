# The admin console's preview lock (src/app/admin/gate.jsx).
#
# Not security: this value is compiled into the client bundle and is readable
# by anyone who opens devtools. It only stops the console being opened by
# accident during a demo. Leave it unset in development and the dev default
# `campus-lead` applies.
VITE_ADMIN_PASSWORD=

# Live backend (dev server only). Copy these into `.env.development.local`.
# Never put SUPABASE_SERVICE_ROLE_KEY or Shopify admin tokens here — the
# browser bundle can only use the anon key.
# VITE_USE_LIVE_BACKEND=1
# VITE_SUPABASE_URL=
# VITE_SUPABASE_ANON_KEY=
#
# Card and wallet checkout run in a separate process (`npm run checkout`).
# The browser calls it here. Leave unset on this computer (127.0.0.1:8787).
# A public build sets the https host of that process, with no path and no secret:
# VITE_API_ORIGIN=https://api.example.com
#
# The checkout process reads secrets from the environment, or from
# CHECKOUT_ENV_FILE when that path exists. Do not copy STRIPE_SECRET_KEY or
# SUPABASE_SERVICE_ROLE_KEY into any VITE_ variable.
#
# CHECKOUT_HOST=127.0.0.1
# CHECKOUT_PORT=8787
# CHECKOUT_ALLOWED_ORIGINS=https://campus.example
# NEXT_PUBLIC_SUPABASE_URL=
# NEXT_PUBLIC_SUPABASE_ANON_KEY=
# SUPABASE_SERVICE_ROLE_KEY=
# STRIPE_SECRET_KEY=
